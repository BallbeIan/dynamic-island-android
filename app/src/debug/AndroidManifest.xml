<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- debug builds only: lets adb create test activities and trigger a pill swap -->
        <receiver android:name="com.ian.island.DebugReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ian.island.DEBUG_TWO" />
                <action android:name="com.ian.island.DEBUG_SWAP" />
                <action android:name="com.ian.island.DEBUG_CLEAR" />
                <action android:name="com.ian.island.DEBUG_TAP" />
                <action android:name="com.ian.island.DEBUG_CLOCK_CANCEL" />
                <action android:name="com.ian.island.DEBUG_WINDOWS" />
                <action android:name="com.ian.island.DEBUG_PREF" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
